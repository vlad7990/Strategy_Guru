# ============================================
# AI CHILDREN'S STORY PUBLISHING PLATFORM
# ============================================

# Database (SQLite for local development, PostgreSQL for production)
DATABASE_URL="file:./dev.db"

# Server
PORT=4000
NODE_ENV=development

# CORS
FRONTEND_URL=http://localhost:3000

# ============================================
# AI SERVICES (REQUIRED)
# ============================================

# OpenAI API - Powers story generation, image creation
# Get your key at: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-your-openai-api-key-here
OPENAI_MODEL=gpt-4o

# ============================================
# OPTIONAL AI SERVICES
# ============================================

# Stable Diffusion XL (via Replicate) - Advanced image generation
# REPLICATE_API_TOKEN=your-replicate-token-here

# ElevenLabs - Voice narration synthesis
# ELEVENLABS_API_KEY=your-elevenlabs-key-here

# ============================================
# STORAGE & ASSETS
# ============================================

# AWS S3 - Store generated images, audio, PDFs
# AWS_ACCESS_KEY_ID=your-aws-access-key
# AWS_SECRET_ACCESS_KEY=your-aws-secret-key
# AWS_S3_BUCKET=your-bucket-name
# AWS_REGION=us-east-1

# ============================================
# PAYMENTS & MARKETPLACE
# ============================================

# Stripe - Marketplace transactions
# STRIPE_SECRET_KEY=sk_test_your-stripe-key
# STRIPE_PUBLISHABLE_KEY=pk_test_your-stripe-key
# STRIPE_WEBHOOK_SECRET=whsec_your-webhook-secret

# ============================================
# COMMUNICATIONS
# ============================================

# SendGrid - Email notifications
# SENDGRID_API_KEY=your-sendgrid-key
# FROM_EMAIL=noreply@yourdomain.com

# ============================================
# SECURITY & AUTH
# ============================================

JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
SESSION_SECRET=your-session-secret-change-this-too

# ============================================
# FEATURE FLAGS
# ============================================

ENABLE_MARKETPLACE=false
ENABLE_VOICE_GENERATION=false
ENABLE_IMAGE_GENERATION=true
ENABLE_MEMORY_SYSTEM=true

# ============================================
# CONTENT SAFETY & LIMITS
# ============================================

# Rate Limiting
MAX_STORIES_PER_DAY=10
MAX_IMAGES_PER_STORY=15

# Safety Settings
SAFETY_LEVEL=strict
REQUIRE_PARENTAL_APPROVAL=true
ENABLE_CONTENT_MODERATION=true

# COPPA Compliance
COPPA_ENABLED=true
MIN_PARENT_AGE=18
DATA_RETENTION_DAYS=90
