# Strategy Guru - Environment Variables Template
# Copy this file to .env.local and fill in your actual values

# ============================================
# APPLICATION
# ============================================
NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ============================================
# DATABASE (Future - Phase 2)
# ============================================
# PostgreSQL connection string
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL=postgresql://postgres:password@localhost:5432/strategy_guru

# Direct URL for migrations (may be same as DATABASE_URL)
DIRECT_URL=postgresql://postgres:password@localhost:5432/strategy_guru

# ============================================
# AUTHENTICATION (Future - Phase 4)
# ============================================
# NextAuth.js configuration
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=your-secret-key-here-generate-with-openssl-rand-base64-32

# OAuth Providers (optional)
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

GITHUB_CLIENT_ID=your-github-client-id
GITHUB_CLIENT_SECRET=your-github-client-secret

# ============================================
# AI / OpenAI (Future - Phase 3)
# ============================================
# OpenAI API Key for AI Assistant
OPENAI_API_KEY=sk-your-openai-api-key-here

# OpenAI Model (default: gpt-4o)
OPENAI_MODEL=gpt-4o

# Max tokens for AI responses
OPENAI_MAX_TOKENS=1000

# ============================================
# EMAIL (Future - Phase 5)
# ============================================
# SendGrid API Key for email notifications
SENDGRID_API_KEY=your-sendgrid-api-key

# From email address
EMAIL_FROM=noreply@strategyguru.com

# ============================================
# INTEGRATIONS (Future - Phase 5)
# ============================================
# Slack Integration
SLACK_BOT_TOKEN=xoxb-your-slack-bot-token
SLACK_SIGNING_SECRET=your-slack-signing-secret

# Jira Integration
JIRA_API_TOKEN=your-jira-api-token
JIRA_EMAIL=your-jira-email
JIRA_HOST=your-company.atlassian.net

# Salesforce Integration
SALESFORCE_CLIENT_ID=your-salesforce-client-id
SALESFORCE_CLIENT_SECRET=your-salesforce-client-secret
SALESFORCE_REDIRECT_URI=http://localhost:3000/api/integrations/salesforce/callback

# ============================================
# MONITORING & LOGGING (Future - Phase 6)
# ============================================
# Sentry for error tracking
SENTRY_DSN=your-sentry-dsn-here

# Log level (debug, info, warn, error)
LOG_LEVEL=info

# ============================================
# REDIS (Future - Optional)
# ============================================
# Redis for caching and sessions
REDIS_URL=redis://localhost:6379

# ============================================
# STORAGE (Future - Optional)
# ============================================
# AWS S3 for file uploads
AWS_ACCESS_KEY_ID=your-aws-access-key
AWS_SECRET_ACCESS_KEY=your-aws-secret-key
AWS_REGION=us-east-1
AWS_S3_BUCKET=strategy-guru-uploads

# ============================================
# RATE LIMITING (Future)
# ============================================
# Requests per minute per user
RATE_LIMIT_RPM=60

# ============================================
# FEATURE FLAGS (Future)
# ============================================
# Enable/disable features
ENABLE_AI_ASSISTANT=true
ENABLE_INTEGRATIONS=false
ENABLE_NOTIFICATIONS=false

# ============================================
# DEVELOPMENT ONLY
# ============================================
# Show debug information
DEBUG=false

# Bypass authentication (development only)
BYPASS_AUTH=false

# ============================================
# NOTES
# ============================================
# 1. Never commit .env or .env.local to version control
# 2. Add .env and .env.local to .gitignore
# 3. Use strong, randomly generated secrets
# 4. Rotate secrets regularly
# 5. Different values for dev/staging/production
# 6. Store production secrets securely (Vercel/Railway secrets)
